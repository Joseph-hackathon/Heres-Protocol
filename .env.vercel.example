# ============================================
# Heres Protocol - Vercel Environment Variables
# ============================================

# --- Solana ---
# NOTE: program ID is NOT configured here. It comes from idl/heres_program.json (declare_id!)
# via constants/index.ts, so it cannot drift from the deployed program. Do not re-add it.
NEXT_PUBLIC_SOLANA_NETWORK=devnet
NEXT_PUBLIC_PLATFORM_FEE_RECIPIENT=Covn3moA8qstPgXPgueRGMSmi94yXvuDCWTjQVBxHpzb
NEXT_PUBLIC_HELIUS_API_KEY=<YOUR_HELIUS_API_KEY>
NEXT_PUBLIC_SOLANA_FALLBACK_RPC_URL=https://api.devnet.solana.com
NEXT_PUBLIC_BTC_MINT=<YOUR_BTC_MINT>
NEXT_PUBLIC_ETH_MINT=<YOUR_ETH_MINT>
NEXT_PUBLIC_MSOL_MINT=mSoLzYCxHdYgdzU16g5QSh3i5K3z3KZK7ytfqcJm7So
SOLANA_RPC_URL=
SOLANA_FALLBACK_RPC_URL=https://api.devnet.solana.com
APP_BASE_URL=https://<YOUR_VERCEL_DOMAIN>
INDEXER_BASE_URL=https://<YOUR_VERCEL_DOMAIN>

# --- Crank (auto-execute & private distribution cron) ---
CRON_SECRET=<YOUR_RANDOM_CRON_SECRET>
CRANK_WALLET_PRIVATE_KEY=<YOUR_CRANK_WALLET_PRIVATE_KEY>

# --- MagicBlock Private Payment API (for distribution) ---
MAGICBLOCK_PRIVATE_PAYMENTS_API_KEY=<YOUR_MAGICBLOCK_API_KEY>
MAGICBLOCK_PRIVATE_PAYMENTS_SECRET=<YOUR_MAGICBLOCK_WEBHOOK_SECRET>
MAGICBLOCK_PRIVATE_PAYMENTS_BASE_URL=https://payments.magicblock.app
USE_MAGICBLOCK_PRIVATE_PAYMENTS=1

# Crank wallet for automation
CRANK_WALLET_PRIVATE_KEY=<YOUR_CRANK_WALLET_PRIVATE_KEY>

# --- MagicBlock ER/TEE endpoints ---
NEXT_PUBLIC_ER_RPC_URL=https://devnet-as.magicblock.app
NEXT_PUBLIC_ER_WS_URL=wss://devnet-as.magicblock.app
NEXT_PUBLIC_TEE_RPC_URL=https://tee.magicblock.app
NEXT_PUBLIC_TEE_AUTH_URL=https://tee.magicblock.app
NEXT_PUBLIC_ER_VALIDATOR=MAS1Dt9qreoRMQ14YQuhg8UTZMMzDdKhmkZMECCzk57
# Relayer pubkey of CRANK_WALLET_PRIVATE_KEY. Default heartbeat_authority on new capsules so the
# liveness cron can bump last_activity. MUST equal the crank wallet's pubkey or heartbeats silently fail.
NEXT_PUBLIC_CRANK_WALLET_PUBLIC_KEY=<CRANK_WALLET_PUBKEY>
NEXT_PUBLIC_MAGIC_PROGRAM_ID=Magic11111111111111111111111111111111111111
# BUFFER_SEED_PROGRAM_ID removed: it equals the program ID, now sourced from the IDL.
NEXT_PUBLIC_MAGIC_CONTEXT=MagicContext1111111111111111111111111111111

# --- Crank (auto-execute cron) ---
CRANK_WALLET_PRIVATE_KEY=<YOUR_CRANK_WALLET_PRIVATE_KEY>

# --- CRE: Mock mode ---
CHAINLINK_CRE_WEBHOOK_URL=https://<YOUR_VERCEL_DOMAIN>/api/mock/cre
CHAINLINK_CRE_SIGNING_SECRET=<YOUR_RANDOM_STRING>
CHAINLINK_CRE_CALLBACK_SECRET=<YOUR_RANDOM_STRING>
CHAINLINK_CRE_REMINDER_WEBHOOK_URL=https://<YOUR_VERCEL_DOMAIN>/api/mock/cre-reminder
CHAINLINK_CRE_REMINDER_SIGNING_SECRET=<YOUR_RANDOM_STRING>
CHAINLINK_CRE_REMINDER_CALLBACK_SECRET=<YOUR_RANDOM_STRING>
CRE_REMINDER_DISPATCH_SECRET=<YOUR_RANDOM_STRING>
CRE_REMINDER_INTERVAL_DAYS=30
MOCK_CRE_AUTO_CALLBACK=true
MOCK_CRE_CALLBACK_BASE_URL=https://<YOUR_VERCEL_DOMAIN>
