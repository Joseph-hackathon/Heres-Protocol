NEXT_PUBLIC_SOLANA_NETWORK=devnet
NEXT_PUBLIC_HELIUS_API_KEY=your_helius_api_key
NEXT_PUBLIC_SOLANA_FALLBACK_RPC_URL=https://api.devnet.solana.com
SOLANA_RPC_URL=
SOLANA_FALLBACK_RPC_URL=https://api.devnet.solana.com
# Program ID is sourced from idl/heres_program.json (declare_id!), not env. Do not re-add it.
NEXT_PUBLIC_PLATFORM_FEE_RECIPIENT=
# Admin explorer allowlist (comma-separated base58 pubkeys). If set, REPLACES the
# built-in defaults. Access is enforced by a wallet-signature check on the server;
# these keys only decide which signed requests are accepted.
NEXT_PUBLIC_ADMIN_WALLETS=
NEXT_PUBLIC_BTC_MINT=
NEXT_PUBLIC_ETH_MINT=
NEXT_PUBLIC_MSOL_MINT=mSoLzYCxHdYgdzU16g5QSh3i5K3z3KZK7ytfqcJm7So
APP_BASE_URL=http://127.0.0.1:3000
INDEXER_BASE_URL=http://127.0.0.1:3000
DATABASE_URL=
HELIUS_WEBHOOK_AUTH_TOKEN=

# MagicBlock Private Payment API (for distribution)
MAGICBLOCK_PRIVATE_PAYMENTS_API_KEY=your_magicblock_api_key
MAGICBLOCK_PRIVATE_PAYMENTS_SECRET=your_webhook_secret
MAGICBLOCK_PRIVATE_PAYMENTS_BASE_URL=https://payments.magicblock.app
USE_MAGICBLOCK_PRIVATE_PAYMENTS=1
MAGICBLOCK_DEPLOYER_PRIVATE_KEY=

# MagicBlock ER/TEE endpoints (these are for the Ephemeral Rollup service)
NEXT_PUBLIC_ER_RPC_URL=https://devnet-as.magicblock.app
NEXT_PUBLIC_ER_WS_URL=wss://devnet-as.magicblock.app
NEXT_PUBLIC_TEE_RPC_URL=https://tee.magicblock.app
NEXT_PUBLIC_TEE_AUTH_URL=https://tee.magicblock.app
NEXT_PUBLIC_ER_VALIDATOR=MAS1Dt9qreoRMQ14YQuhg8UTZMMzDdKhmkZMECCzk57
NEXT_PUBLIC_MAGIC_PROGRAM_ID=Magic11111111111111111111111111111111111111
# BUFFER_SEED_PROGRAM_ID removed: equals the program ID, sourced from the IDL.
NEXT_PUBLIC_MAGIC_CONTEXT=MagicContext1111111111111111111111111111111

# Dashboard indexing
DASHBOARD_PREWARM_ENABLED=0
DASHBOARD_PREWARM_PAGES=1,2,3
DASHBOARD_PREWARM_TOKEN=
CRON_SECRET=

# Intent delivery (self-hosted: at-rest encryption + Resend email)
# 32-byte key for server-side AES-256-GCM of intent statements at rest.
# Generate with: openssl rand -base64 32   (REQUIRED in production)
INTENT_AT_REST_KEY=
# Resend transactional email (the delivery leg). Verified sender required.
RESEND_API_KEY=
RESEND_FROM=Heres Protocol <noreply@heresprotocol.com>
# Public base URL used to build capsule links inside delivery emails.
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3000
# Optional: secret-authed manual dispatch triggers (fall back to CRON_SECRET).
INTENT_DISPATCH_SECRET=
INTENT_REMINDER_DISPATCH_SECRET=
# Optional: ops alert webhook (Slack-style) for dead-lettered deliveries.
OPS_ALERT_WEBHOOK_URL=
# Optional: reminder cadence + local store-file override (dev file fallback).
INTENT_REMINDER_INTERVAL_DAYS=30
INTENT_STORE_PATH=

# Cron automation
CRON_SECRET=
CRANK_WALLET_PRIVATE_KEY=
# Relayer pubkey for the keypair above. Used client-side as the default heartbeat_authority on new
# capsules so the liveness cron can bump last_activity. MUST equal the pubkey of CRANK_WALLET_PRIVATE_KEY.
NEXT_PUBLIC_CRANK_WALLET_PUBLIC_KEY=

# Redis
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
